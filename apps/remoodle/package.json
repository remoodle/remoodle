{
  "name": "@heresy/remoodle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-s paraglide:compile dev:run",
    "dev:run": "run-p dev:bot dev:worker dev:api",
    "dev:bot": "tsx watch src/bot/index.ts | pino-pretty",
    "dev:worker": "tsx src/worker/index.ts | pino-pretty",
    "dev:api": "tsx watch src/api/index.ts | pino-pretty",
    "start": "run-p start:bot start:worker start:api",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/library/i18n --strategy baseLocale --emit-ts-declarations --no-emit-prettier-ignore --no-emit-readme",
    "build": "run-s paraglide:compile build:ts",
    "build:ts": "vp pack",
    "test": "run-s paraglide:compile test:vitest",
    "test:vitest": "vp test",
    "start:bot": "node dist/db/migrate.mjs && node dist/bot/index.mjs",
    "start:worker": "node dist/db/migrate.mjs && node dist/worker/index.mjs",
    "start:api": "node dist/db/migrate.mjs && node dist/api/index.mjs",
    "format": "vp fmt .",
    "lint": "vp lint .",
    "type-check": "run-s paraglide:compile type-check:ts",
    "type-check:ts": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@grammyjs/hydrate": "^1.6.0",
    "@hatchet-dev/typescript-sdk": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@libsql/client": "^0.17.2",
    "@loglayer/hono": "catalog:",
    "@loglayer/transport-pino": "catalog:",
    "better-all": "catalog:",
    "callback-data": "^1.1.1",
    "dayjs": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "envalid": "catalog:",
    "grammy": "^1.38.3",
    "hono": "catalog:",
    "ical.js": "catalog:",
    "loglayer": "catalog:",
    "pino": "catalog:",
    "temporal-polyfill": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-message-format": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "npm-run-all2": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
