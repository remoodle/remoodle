/**
 * Static SPA only. All data and auth live in the remoodle API (VITE_API_URL).
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar",
  "compatibility_date": "2025-09-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "preview_urls": true,
  // The old full-stack worker ran a per-minute cron; an empty list removes it on deploy.
  "triggers": { "crons": [] },
}
